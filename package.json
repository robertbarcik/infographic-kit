    "authoring": "node engine/list.mjs --authoring",
    "test": "node engine/tools/selftest.mjs"
  },
  "dependencies": {
    "lucide-static": "^1.48.0",
    "puppeteer-core": "^25.12.0",
    "roughjs": "^4.6.6"
